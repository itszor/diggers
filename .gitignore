# Python / editors
__pycache__/
*.pyc
*.swp

# The original game and everything made from it stay out of the
# repository: build.sh (recipe.json) remakes them from the user's own copy.
*.zip
*.adf
*.hfe
extracted/
game/
unpacked/
analysis/*.json
analysis/*.dis

# Recompilation: generated C, objects, binaries, run outputs
recomp/gen/
recomp/genintro/
recomp/genoutro/
recomp/genmode/
recomp/genptr/
recomp/*.o
recomp/diggers
recomp/*.events
recomp/*.vdu
recomp/*.screen
recomp/*.regs
recomp/*.bmp
recomp/*.png
recomp/*.wav
recomp/vidc.log
recomp/untranslated.log
recomp/savedata/

# headless test runs (each in its own directory beside recomp/)
run*/
